{
  // Client half: browser sources only (src/client/** + shared src/presets.ts
  // and src/key-ref.ts, both dependency-free so both halves compile them).
  // JSX via react-jsx, DOM libs, no node ambient types — matches the official
  // client base shape.
  //
  // Type-check-only program: this half never emits. lib/client.js is produced
  // by tsdown (which bundles without type-checking), and no .d.ts is published
  // for it — package.json exports["./client"] therefore has no `types` entry,
  // and `declaration` / `declarationMap` / `declarationDir` are deliberately
  // absent here (they would have no effect without emit).
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "sourceMap": true,
    "noEmit": true,
    "rootDir": "src"
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/presets.ts", "src/key-ref.ts"]
}
